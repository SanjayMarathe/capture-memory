# Preferred: hosted Cognee. If these are absent, the backend uses the local
# SDK and requires LLM_API_KEY instead.
COGNEE_API_URL=
COGNEE_API_KEY=
COGNEE_TENANT_ID=

# Local Cognee fallback — see https://docs.cognee.ai/setup-configuration/llm-providers
LLM_API_KEY=

# HydraDB v2. HYDRA_DB_API_KEY remains supported as a legacy alias.
HYDRA_API_KEY=
HYDRA_DATABASE=default-tenant
HYDRA_COLLECTION=capture-memory
